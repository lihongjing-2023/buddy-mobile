{
  "name": "cockpit-tools-mobile",
  "version": "1.1.3",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "expo export --platform android",
    "build:ios": "expo export --platform ios",
    "build:web": "expo export --platform web",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ignore-path .eslintignore",
    "doctor": "npx expo-doctor",
    "check-deps": "npx expo install --check",
    "ci": "npm run check-deps && npm run lint && npm run typecheck && npm run doctor",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.0",
    "expo-build-properties": "~0.13.3",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.8",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~55.0.17",
    "expo-intent-launcher": "~12.0.2",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~8.0.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "metro-minify-terser": "^0.84.3",
    "typescript": "~5.8.0"
  },
  "private": true
}
